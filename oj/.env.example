NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/oj_dev
DNS_SERVERS=

# Replace with a newly generated random value of at least 32 characters.
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14

CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15
TRUST_PROXY=0

SANDBOX_DRIVER=docker
JUDGE_IMAGE=oj-judge-runtime:dev
JUDGE_CONCURRENCY=1
JUDGE_MAX_ATTEMPTS=3
JUDGE_LEASE_SEC=60
JUDGE_JOB_RETENTION_DAYS=30
JUDGE_CPUSET=

# Keep mock for local development. For live AI set provider, account-enabled
# model ID, and key in the server environment only.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
AI_MAX_TOKENS=400

AI_DAILY_MESSAGE_LIMIT=30
AI_MIN_ATTEMPT_CHARS=20
AI_L2_UNLOCK_MINUTES=15
AI_UNLOCK_COOLDOWN_SEC=300
AI_LEAK_CLASSIFIER=on
AI_REDTEAM_LIVE=0
